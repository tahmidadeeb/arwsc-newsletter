# Copy these into Vercel → Project → Settings → Environment Variables.
# Never put real secrets in this repository: it is public.

# Your Kit form ID (the number in the form's embed code, e.g. 1234567).
# Leave empty to show "Signups opening soon".
PUBLIC_KIT_FORM_ID=

# The public address of the site, e.g. https://newsletter.example.edu
# Leave empty to use Vercel's own address automatically.
SITE_URL=
