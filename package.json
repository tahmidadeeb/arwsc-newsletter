{
  "name": "arwsc-newsletter",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "the arw,sc newsletter — Academic and Research Wing, Science Club",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "validate": "tsx scripts/validate.ts",
    "build": "npm run validate && npm run clean && astro build && tsx scripts/check-images.ts",
    "preview": "astro preview",
    "test": "vitest run",
    "test:fixtures": "tsx scripts/test-fixtures.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "astro sync && tsc --noEmit && tsx scripts/doc-check.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "node-html-parser": "9.0.5",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "fast-xml-parser": "5.11.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
