---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { isPlaceholder, loadSite } from '../lib/data';

const site = loadSite();
const emailReady = !isPlaceholder(site.contactEmail);
---
<Base title="Contact and join" description={`Contact ${site.clubName} or join the club.`} ogImage="/og/contact.png">
  <div class="wrap">
    <PageHead kicker="Get in touch" title="Contact & join" lede={site.join.text} />
    <div class="ct">
      <section class="ct__block" aria-labelledby="ct-email">
        <h2 id="ct-email" class="label ct__h">Write to the editors</h2>
        {emailReady ? (
          <a class="ct__email" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        ) : (
          <p class="ct__email ct__email--todo">{site.contactEmail}</p>
        )}
        <p class="ct__note">{site.contact.note}</p>
      </section>
      {site.social.length > 0 && (
        <section class="ct__block" aria-labelledby="ct-social">
          <h2 id="ct-social" class="label ct__h">Elsewhere</h2>
          <ul class="ct__social">
            {site.social.map((s) => (
              <li>
                {isPlaceholder(s.url) ? (
                  <span>{s.label}</span>
                ) : (
                  <a href={s.url} rel="me noopener" target="_blank">{s.label} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .ct {
    display: grid;
    gap: 3rem;
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }
  @media (min-width: 56rem) {
    .ct {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 5rem;
    }
  }
  .ct__h {
    margin: 0 0 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--ink);
  }
  .ct__email {
    display: inline-block;
    margin: 0;
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1.8rem, 1.2rem + 2.6vw, 3.4rem);
    line-height: 1.1;
    color: var(--accent-text);
    overflow-wrap: anywhere;
  }
  .ct__email--todo {
    color: var(--ink-soft);
  }
  .ct__note {
    margin: 1rem 0 0;
    color: var(--ink-soft);
  }
  .ct__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-family: var(--f-display);
    font-size: 1.5rem;
  }
  .ct__social a {
    text-decoration: none;
  }
  .ct__social a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
</style>
