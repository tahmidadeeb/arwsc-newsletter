---
/** Specimen tag: a thin outlined label with an optional mono index cell. */
import { pad2 } from '../lib/nav';
interface Props {
  label: string;
  index?: number;
  href?: string;
  tone?: 'accent' | 'on-accent' | 'ink';
  /** Show only the number box (when the name is already shown beside it). */
  numberOnly?: boolean;
}
const { label, index, href, tone = 'accent', numberOnly = false } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag class:list={['tag', `tag--${tone}`]} href={href} aria-hidden={numberOnly ? 'true' : undefined}>
  {index !== undefined && <span class:list={['tag__i', numberOnly && 'tag__i--solo']} aria-hidden="true">{pad2(index)}</span>}
  {!numberOnly && <span class="tag__l">{label}</span>}
</Tag>

<style>
  .tag {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid currentColor;
    font-family: var(--f-label);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    max-width: 100%;
  }
  .tag--accent { color: var(--accent-text); }
  .tag--on-accent { color: var(--on-accent); }
  .tag--ink { color: var(--ink); }
  .tag__i {
    font-family: var(--f-mono);
    font-weight: 400;
    letter-spacing: 0.04em;
    padding: 0.42em 0.55em;
    border-right: 1px solid currentColor;
  }
  .tag__i--solo {
    border-right: 0;
  }
  .tag__l {
    padding: 0.42em 0.7em 0.42em 0.75em;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  a.tag:hover {
    background: currentColor;
  }
  a.tag:hover .tag__l,
  a.tag:hover .tag__i {
    color: var(--paper);
  }
</style>
