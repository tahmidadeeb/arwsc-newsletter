---
/**
 * "In this issue": the articles grouped by section, journal style.
 * Frontier dispatches are short and live only in their own section below,
 * so sections with the "frontier" treatment are left out of this list.
 */
import type { Article } from '../lib/content';
import { formatAuthors } from '../lib/format';
import { articleUrl } from '../lib/nav';
import type { Segment } from '../lib/types';

interface Props {
  groups: { segment: Segment; articles: Article[] }[];
  title?: string;
}
const { groups: all, title = 'In this issue' } = Astro.props;
const groups = all.filter((g) => g.segment.treatment !== 'frontier');
const n = groups.reduce((t, g) => t + g.articles.length, 0);
---
{n > 0 && (
  <nav class="toc" aria-labelledby="toc-h">
    <h2 class="toc__h label" id="toc-h">{title}<span class="mono toc__total">{n} {n === 1 ? 'article' : 'articles'}</span></h2>
    <div class="toc__cols">
      {groups.map(({ segment, articles }) => (
        <section class="toc__group">
          <h3 class="toc__seg"><a href={`#${segment.key}`}>{segment.label}</a></h3>
          <ol class="toc__list">
            {articles.map((a) => (
              <li class="toc__item">
                <span class="toc__body">
                  <a class="toc__t" href={articleUrl(a.issue, a.slug)}>{a.title}</a>
                  <span class="toc__by">{formatAuthors(a.authors.slice(0, 2))}{a.authors.length > 2 ? ' et al.' : ''}</span>
                </span>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </nav>
)}

<style>
  .toc__h {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-family: var(--f-label);
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 0.4rem;
  }
  .toc__total {
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-soft);
  }
  .toc__cols {
    columns: 1;
    column-gap: 2.5rem;
  }
  @media (min-width: 44rem) {
    .toc__cols {
      columns: 2;
    }
  }
  .toc__group {
    padding-top: 1.1rem;
  }
  .toc__seg {
    break-after: avoid;
  }
  .toc__seg {
    font-size: 1.15rem;
    font-style: italic;
    font-weight: 700;
    margin-bottom: 0.3rem;
    color: var(--accent-text);
  }
  .toc__seg a {
    text-decoration: none;
  }
  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc__item {
    padding: 0.5rem 0;
    border-bottom: 1px dotted var(--rule);
    break-inside: avoid;
  }
  .toc__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .toc__t {
    font-size: 1.02rem;
    line-height: 1.3;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .toc__t:hover {
    text-decoration: underline;
  }
  .toc__by {
    font-family: var(--f-label);
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
</style>
