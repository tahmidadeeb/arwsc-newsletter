---
interface Props {
  title: string;
  kicker?: string;
  lede?: string;
  /** Lede as trusted HTML (already escaped), e.g. from inlineItalics(). */
  ledeHtml?: string;
}
const { title, kicker, lede, ledeHtml } = Astro.props;
const hasAside = Astro.slots.has('aside');
---
<header class:list={['ph-head', hasAside && 'ph-head--aside']}>
  <div class="ph-head__main">
    {kicker && <p class="label ph-head__k reveal" style="--i:0">{kicker}</p>}
    <h1 class="ph-head__t reveal" style="--i:1">{title}</h1>
    {ledeHtml ? <p class="ph-head__lede reveal" style="--i:2" set:html={ledeHtml} /> : lede && <p class="ph-head__lede reveal" style="--i:2">{lede}</p>}
  </div>
  {hasAside && <div class="ph-head__aside reveal" style="--i:3"><slot name="aside" /></div>}
</header>

<style>
  .ph-head {
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--ink);
  }
  .ph-head--aside {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 60rem) {
    .ph-head--aside {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 5rem;
      align-items: center;
    }
  }
  .ph-head__k {
    margin: 0 0 1rem;
    color: var(--accent-text);
  }
  .ph-head__t {
    font-size: clamp(3rem, 2rem + 5vw, 6.5rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.015em;
  }
  .ph-head__lede {
    margin: 1.4rem 0 0;
    max-width: 38ch;
    font-family: var(--f-display);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
    line-height: 1.3;
  }
</style>
