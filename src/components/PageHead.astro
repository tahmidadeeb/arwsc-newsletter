---
interface Props {
  title: string;
  kicker?: string;
  lede?: string;
}
const { title, kicker, lede } = Astro.props;
---
<header class="ph-head">
  {kicker && <p class="label ph-head__k reveal" style="--i:0">{kicker}</p>}
  <h1 class="ph-head__t reveal" style="--i:1">{title}</h1>
  {lede && <p class="ph-head__lede reveal" style="--i:2">{lede}</p>}
</header>

<style>
  .ph-head {
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(1.5rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--ink);
  }
  .ph-head__k {
    margin: 0 0 1rem;
    color: var(--accent-text);
  }
  .ph-head__t {
    font-size: clamp(3rem, 2rem + 5vw, 6.5rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.015em;
  }
  .ph-head__lede {
    margin: 1.4rem 0 0;
    max-width: 38ch;
    font-family: var(--f-display);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
    line-height: 1.3;
  }
</style>
