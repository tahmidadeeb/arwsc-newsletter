---
import { formatAuthors } from '../lib/format';
interface Props {
  authors: string[];
  size?: 'sm' | 'md';
  /** Show at most this many names, then "and N others". */
  max?: number;
}
const { authors, size = 'sm', max = 6 } = Astro.props;
const shown = authors.length > max ? [...authors.slice(0, max - 1), `${authors.length - max + 1} others`] : authors;
---
{authors.length > 0 && (
  <p class:list={['byline', `byline--${size}`]}>
    <span class="byline__by">By {formatAuthors(shown)}</span>
  </p>
)}

<style>
  .byline {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    font-family: var(--f-label);
    color: var(--ink-soft);
  }
  .byline--sm { font-size: 0.8125rem; }
  .byline--md { font-size: 0.9375rem; }
  .byline__by {
    font-weight: 600;
    color: var(--ink);
  }
</style>
