---
/**
 * Self-hosted fonts, Latin and Latin Extended only. Browsers download a
 * file only when the page uses characters in its range. Playfair Display
 * (headlines) and Newsreader (body) use their weight-axis files.
 */
import dispN from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';
import dispI from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-italic.woff2?url';
import dispNX from '@fontsource-variable/playfair-display/files/playfair-display-latin-ext-wght-normal.woff2?url';
import dispIX from '@fontsource-variable/playfair-display/files/playfair-display-latin-ext-wght-italic.woff2?url';
import newsN from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import newsI from '@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url';
import newsNX from '@fontsource-variable/newsreader/files/newsreader-latin-ext-wght-normal.woff2?url';
import newsIX from '@fontsource-variable/newsreader/files/newsreader-latin-ext-wght-italic.woff2?url';
import schN from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import schNX from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-ext-wght-normal.woff2?url';
import monoN from '@fontsource/fragment-mono/files/fragment-mono-latin-400-normal.woff2?url';
import monoNX from '@fontsource/fragment-mono/files/fragment-mono-latin-ext-400-normal.woff2?url';

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT =
  'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

type Face = [family: string, style: string, weight: string, url: string, range: string, variable: boolean];
const faces: Face[] = [
  ['Playfair Display Variable', 'normal', '400 900', dispN, LATIN, true],
  ['Playfair Display Variable', 'normal', '400 900', dispNX, LATIN_EXT, true],
  ['Playfair Display Variable', 'italic', '400 900', dispI, LATIN, true],
  ['Playfair Display Variable', 'italic', '400 900', dispIX, LATIN_EXT, true],
  ['Newsreader Variable', 'normal', '200 800', newsN, LATIN, true],
  ['Newsreader Variable', 'normal', '200 800', newsNX, LATIN_EXT, true],
  ['Newsreader Variable', 'italic', '200 800', newsI, LATIN, true],
  ['Newsreader Variable', 'italic', '200 800', newsIX, LATIN_EXT, true],
  ['Schibsted Grotesk Variable', 'normal', '400 900', schN, LATIN, true],
  ['Schibsted Grotesk Variable', 'normal', '400 900', schNX, LATIN_EXT, true],
  ['Fragment Mono', 'normal', '400', monoN, LATIN, false],
  ['Fragment Mono', 'normal', '400', monoNX, LATIN_EXT, false],
];
const css = faces
  .map(
    ([family, style, weight, url, range, variable]) =>
      `@font-face{font-family:'${family}';font-style:${style};font-display:swap;font-weight:${weight};` +
      `src:url(${url}) format('${variable ? 'woff2-variations' : 'woff2'}');unicode-range:${range}}`,
  )
  .join('\n');
---
<link rel="preload" href={dispN} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={newsN} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
