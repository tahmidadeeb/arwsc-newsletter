---
import { headlineHtml } from '../../lib/format';
import type { Article } from '../../lib/content';
import { formatAuthors } from '../../lib/format';
import { articleUrl } from '../../lib/nav';

interface Props {
  article: Article;
}
const { article: a } = Astro.props;
// Only dated announcements show a date (see Article.shownDate).
const d = a.shownDate;
const day = d?.getUTCDate();
const mon = d?.toLocaleString('en-GB', { month: 'short', timeZone: 'UTC' });
---
<article class:list={['nt', 'has-stretch', 'card-lift', d && 'nt--dated']}>
  {d && (
    <time class="nt__date" datetime={d.toISOString().slice(0, 10)}>
      <span class="nt__day">{day}</span>
      <span class="nt__mon mono">{mon}</span>
    </time>
  )}
  <div class="nt__body">
    <h3 class="nt__t">
      <a class="stretch hover-title" href={articleUrl(a.issue, a.slug)} set:html={headlineHtml(a.title)} />
    </h3>
    <p class="nt__s">{a.summary}</p>
    <p class="nt__by label">{formatAuthors(a.authors.slice(0, 2))}{a.authors.length > 2 ? ' et al.' : ''}</p>
  </div>
</article>

<style>
  .nt {
    padding: 1.1rem 1.2rem;
    border: 1px dashed color-mix(in oklab, var(--ink) 45%, transparent);
    background: var(--paper-deep);
    min-width: 0;
  }
  .nt--dated {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }
  .nt__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3rem;
    padding-right: 1rem;
    border-right: 1px solid var(--rule);
    color: var(--accent-text);
  }
  .nt__day {
    font-family: var(--f-display);
    font-size: 2.2rem;
    line-height: 1;
  }
  .nt__mon {
    font-size: 0.7rem;
    text-transform: uppercase;
  }
  .nt__body {
    min-width: 0;
  }
  .nt__t {
    font-size: 1.3rem;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  .nt__t a {
    text-decoration: none;
  }
  .nt__s {
    margin: 0.4rem 0;
    font-size: 0.975rem;
    color: var(--ink-soft);
  }
  .nt__by {
    margin: 0;
    font-size: 0.6875rem;
    color: var(--ink-soft);
  }
</style>
