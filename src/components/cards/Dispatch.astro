---
import { headlineHtml } from '../../lib/format';
import type { Article } from '../../lib/content';
import { formatAuthors } from '../../lib/format';
import { articleUrl } from '../../lib/nav';

interface Props {
  article: Article;
}
const { article: a } = Astro.props;
---
<article class="dp has-stretch">
  <div class="dp__body">
    <h3 class="dp__t">
      <a class="stretch hover-title" href={articleUrl(a.issue, a.slug)} set:html={headlineHtml(a.title)} />
    </h3>
    <p class="dp__s">{a.summary}</p>
    <p class="dp__meta mono">{formatAuthors(a.authors.slice(0, 3))}{a.authors.length > 3 ? ' et al.' : ''}</p>
  </div>
</article>

<style>
  .dp {
    display: grid;
    padding: 1.1rem 0 1.2rem;
    border-top: 1px solid var(--rule);
    min-width: 0;
  }
  .dp__body {
    min-width: 0;
  }
  .dp__t {
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.55rem);
    line-height: 1.12;
    overflow-wrap: anywhere;
  }
  .dp__t a {
    text-decoration: none;
  }
  .dp__s {
    margin: 0.45rem 0 0.5rem;
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .dp__meta {
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
</style>
